# Переменные окружения DEEP Messenger
# Скопируй этот файл в .env и заполни значения перед запуском

# ──────────────────────────────────────
# Обязательные переменные
# ──────────────────────────────────────

# Секретный ключ для подписи JWT-токенов (минимум 32 символа, любая случайная строка)
JWT_SECRET=замените_на_длинную_случайную_строку_минимум_32_символа

# Код доступа первого администратора (UUID или любая секретная фраза)
# После первого запуска этот код появится в белом списке и его можно будет использовать для входа
ADMIN_CODE=замените_на_ваш_секретный_код_администратора

# ──────────────────────────────────────
# Переменные для Push-уведомлений (VAPID)
# Получить можно запустив: node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log(JSON.stringify(k));"
# в папке server после npm install
# ──────────────────────────────────────

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=your-email@example.com

# ──────────────────────────────────────
# Необязательные переменные
# ──────────────────────────────────────

# Порт сервера (по умолчанию 3000, на Render/Railway задаётся автоматически)
PORT=3000
